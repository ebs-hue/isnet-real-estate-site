{
  "version": 1,
  "publish_policy": {
    "mode": "automatic_for_events",
    "default_mode": "automatic",
    "module_overrides": {
      "events": "automatic"
    },
    "automatic_when": {
      "qa_passed": true,
      "image_rights": "approved",
      "duplicate_risk": "low",
      "source_confidence": [
        "high",
        "medium"
      ],
      "required_fields_complete": true,
      "category_editor_decision": [
        "normal",
        "recommended",
        "promoted",
        "hero_candidate"
      ]
    },
    "exception_queue_when": [
      "low_confidence",
      "unclear_image_rights",
      "possible_duplicate",
      "missing_required_field",
      "broken_ticket_or_source_link",
      "date_or_location_conflict",
      "sensitive_or_legal_risk"
    ],
    "exception_behavior": "hold_and_surface",
    "human_approval_required_for_events": false
  },
  "workflow": [
    "collector",
    "dedupe",
    "enrichment",
    "media",
    "taxonomy",
    "seo",
    "qa",
    "category_editor",
    "chief_editor",
    "publisher"
  ],
  "agents": [
    {
      "id": "collector",
      "name": "סוכן איסוף",
      "status": "planned",
      "order": 1,
      "purpose": "אוסף את נתוני האירוע מהמקור, כולל תמונה כאשר היא זמינה, יחד עם מקור, קרדיט וסטטוס זכויות ראשוני.",
      "can": [
        "collect_event_details",
        "collect_source_url",
        "collect_image_url",
        "collect_image_source",
        "collect_image_credit",
        "collect_image_candidates",
        "record_initial_rights_status",
        "create_draft"
      ],
      "cannot": [
        "publish",
        "delete_content"
      ],
      "output_fields": [
        "title",
        "start_date",
        "start_time",
        "venue",
        "source_url",
        "image_url",
        "image_source",
        "image_credit",
        "image_candidates",
        "image_rights_status"
      ]
    },
    {
      "id": "dedupe",
      "name": "סוכן מניעת כפילויות",
      "status": "planned",
      "order": 2,
      "purpose": "השוואת כותרת, תאריך, מקום, מארגן ומקור כדי למנוע יצירת אירועים כפולים.",
      "can": [
        "compare_events",
        "flag_duplicate",
        "merge_suggestion"
      ],
      "cannot": [
        "hard_delete",
        "publish"
      ]
    },
    {
      "id": "enrichment",
      "name": "סוכן כתיבה והעשרה",
      "status": "priority",
      "order": 3,
      "purpose": "לוקח את המידע הגולמי על האירוע והופך אותו לתוכן מלא ומוכן לפרסום: כותרת, תקציר, תיאור, פרטים שימושיים והשלמות ממקורות מאומתים בלבד.",
      "can": [
        "write_title",
        "write_short_pitch",
        "write_long_description",
        "complete_verified_details",
        "rewrite_for_clarity",
        "flag_missing_facts"
      ],
      "cannot": [
        "invent_facts",
        "invent_quotes",
        "invent_prices_or_times",
        "publish"
      ],
      "output_fields": [
        "title",
        "short_pitch",
        "long_description",
        "verified_facts",
        "missing_information"
      ],
      "writing_rules": [
        "עברית טבעית וקריאה",
        "לא להמציא פרטים שאינם נתמכים במקור",
        "להפריד בין עובדה למידע שיווקי של המארגן",
        "להעדיף ניסוח מקומי ורלוונטי לעיר",
        "להימנע מניסוחים גנריים או מלאכותיים"
      ]
    },
    {
      "id": "media",
      "name": "סוכן מדיה ותמונות",
      "status": "priority",
      "order": 4,
      "purpose": "מטפל רק באירועים שבהם אין תמונה תקינה מהאיסוף, או כשהתמונה בעייתית מבחינת זכויות, איכות או התאמה.",
      "strategy": [
        "בדיקת תמונת המקור שנאספה",
        "חיפוש בבנק המדיה",
        "חיפוש במקורות מורשים",
        "יצירת AI רק אם לא נמצאה חלופה מתאימה",
        "שמירת מקור, קרדיט, זכויות וסימון AI"
      ],
      "can": [
        "search_media_bank",
        "search_allowed_sources",
        "propose_image",
        "generate_ai_image",
        "record_credit",
        "record_rights",
        "flag_ai_generated"
      ],
      "cannot": [
        "use_unclear_rights",
        "misrepresent_ai_as_real_photo",
        "publish"
      ],
      "trigger_when": [
        "missing_image",
        "unclear_image_rights",
        "image_quality_low",
        "image_not_relevant"
      ]
    },
    {
      "id": "taxonomy",
      "name": "סוכן שיוך",
      "status": "planned",
      "order": 5,
      "purpose": "שיוך לקטגוריות, קהלים, נושאים, גופים ויעדי הפצה מתוך המילון המאושר בלבד.",
      "can": [
        "select_existing_taxonomy",
        "suggest_distribution"
      ],
      "cannot": [
        "create_taxonomy_value",
        "publish"
      ]
    },
    {
      "id": "seo",
      "name": "סוכן SEO וקידום",
      "status": "planned",
      "order": 6,
      "purpose": "הכנת כותרת לגוגל, תיאור, Slug, Schema והמלצות קידום והפצה.",
      "can": [
        "suggest_seo",
        "suggest_slug",
        "suggest_promotion",
        "suggest_internal_links"
      ],
      "cannot": [
        "publish"
      ]
    },
    {
      "id": "qa",
      "name": "סוכן בקרת איכות",
      "status": "priority",
      "order": 7,
      "purpose": "בדיקה אחרונה של שלמות, אמינות, תמונה, זכויות, תאריך, קישורים, כפילויות ו-SEO.",
      "can": [
        "score_completeness",
        "score_confidence",
        "flag_errors",
        "mark_ready_for_review"
      ],
      "cannot": [
        "publish"
      ]
    },
    {
      "id": "category_editor",
      "name": "סוכן עורך קטגוריה",
      "status": "priority",
      "order": 8,
      "purpose": "עורך את המדור אוטומטית: חשיבות, בולטות, איזון תוכן וקידום; אירועים תקינים ממשיכים לפרסום ללא המתנה לאדם.",
      "can": [
        "review_section_mix",
        "score_editorial_value",
        "recommend_promotion",
        "recommend_hold",
        "recommend_publish",
        "recommend_homepage_position"
      ],
      "cannot": [
        "change_taxonomy_dictionary",
        "bypass_quality_rules"
      ],
      "decision_outputs": [
        "normal",
        "recommended",
        "promoted",
        "hero_candidate",
        "hold",
        "reject"
      ]
    },
    {
      "id": "chief_editor",
      "name": "סוכן עורך ראשי",
      "status": "planned",
      "order": 9,
      "purpose": "מסתכל על כלל הערים והקטגוריות, מזהה חשיבות רוחבית ומחליט מה ראוי לחשיפה רחבה ברשת.",
      "can": [
        "compare_across_sites",
        "recommend_network_promotion",
        "prioritize_breaking_or_high_value_content",
        "resolve_editorial_conflicts"
      ],
      "cannot": [
        "override_blocked_rights",
        "bypass_high_risk_review"
      ]
    },
    {
      "id": "publisher",
      "name": "סוכן פרסום",
      "status": "priority",
      "order": 10,
      "purpose": "מפרסם אוטומטית אירועים שעברו את כל הבדיקות; רק חריגים נעצרים ונכנסים לתור טיפול.",
      "can": [
        "publish",
        "schedule",
        "distribute_to_city",
        "distribute_to_section",
        "distribute_to_homepage",
        "return_for_review"
      ],
      "cannot": [
        "publish_blocked_content",
        "publish_without_required_fields"
      ],
      "modes": [
        "automatic",
        "exception_queue",
        "manual_only"
      ],
      "default_mode": "automatic"
    }
  ],
  "media_policy": {
    "statuses": [
      "approved",
      "needs_review",
      "blocked"
    ],
    "types": [
      "original_photo",
      "press_photo",
      "licensed_image",
      "ai_generated",
      "illustration"
    ],
    "required_metadata": [
      "source",
      "credit",
      "rights_status",
      "ai_generated",
      "approved_for_homepage",
      "approved_for_social"
    ]
  }
}