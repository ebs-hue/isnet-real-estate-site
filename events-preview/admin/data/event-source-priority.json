    "ticketed_board_authority": {
      "applies_to": [
        "music",
        "standup",
        "kids",
        "theatre"
      ],
      "rule": "Verified active ticket sales listing for the exact city and occurrence can establish show title, local date, local time, venue and ticket link without mandatory venue recheck.",
      "production_materials": "Treat listing description, production genre and photograph as high-priority supplied promotional evidence, subject to exact-show matching and rights constraints for image republication.",
