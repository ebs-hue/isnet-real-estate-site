  "enrichment_pipeline": {
    "version": 1,
    "applies_to": [
      "ashdod",
      "rishon-lezion"
    ],
    "order": [
      {
        "step": 1,
        "id": "original-source",
        "purpose": [
          "local_date",
          "local_time",
          "local_venue",
          "local_occurrence_identity"
        ],
        "stop_for_field_when_verified": false
      },
      {
        "step": 2,
        "id": "same-production-national-boards",
        "source_ids": [
          "friends-hist",
          "mevalim",
          "makore",
          "tickchak-live",
          "sababa-events",
          "leaan",
          "tickchak-home"
        ],
        "search_by": [
          "production_title",
          "performer",
          "production_company",
          "original_event_source_title"
        ],
        "allow_other_city_for": [
          "production_description",
          "cast",
          "genre",
          "category",
          "subcategory",
          "image_candidate"
        ],
        "never_copy_other_city": [
          "event_date",
          "event_time",
          "venue",
          "local_ticket_url"
        ],
        "only_same_production": true,
        "stop_for_field_when_verified": true
      },
      {
        "step": 3,
        "id": "internal-subcategory-image-bank",
        "map": "events-preview/admin/data/subcategory-image-map.json",
        "requires_verified_subcategory": true
      },
      {
        "step": 4,
        "id": "internal-primary-category-image-bank",
        "map": "events-preview/admin/data/subcategory-image-map.json"
      }
    ],
    "publication_guards": {
      "source_prose_requires_editorial_rewrite": true,
      "image_requires_authorized_reuse": true,
      "never_publish_unverified_external_image": true,
      "never_overwrite_manually_verified_content": true,
      "preserve_origin_urls": true,
      "local_venue_does_not_override_better_production_content": true
    },
    "field_priority": {
      "date_time_venue": [
        "local_venue_or_organizer_verified_occurrence",
        "official_local_ticket_page"
      ],
      "production_description": [
        "official_production_or_artist",
        "verified_same_production_national_board",
        "venue_if_substantive_and_verified"
      ],
      "category_subcategory": [
        "explicit_genre_on_official_production",
        "explicit_genre_on_verified_national_board",
        "evidence_in_production_description",
        "venue_when_clear"
      ],
      "image": [
        "licensed_official_production_image_any_city",
        "licensed_verified_same_production_image_national_board",
        "registered_subcategory_bank_image",
        "registered_primary_category_bank_image"
      ]
    },
    "rule": "The venue is authoritative for the local occurrence's date, time and place, not automatically preferred for images, description or genre. For each field select the most reliable and complete verified evidence regardless of discovery order."
  }
